{
  "name": "@hysilens/plugin",
  "version": "0.2.0",
  "description": "Hysilens 歌词插件 SDK、PluginHost、hysilens CLI 与 Vite 集成",
  "keywords": [
    "hysilens",
    "lyrics",
    "obs",
    "plugin",
    "vite"
  ],
  "homepage": "https://github.com/YanChenBai/hysilens/blob/main/packages/plugin/README.md",
  "bugs": {
    "url": "https://github.com/YanChenBai/hysilens/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanChenBai/hysilens.git",
    "directory": "packages/plugin"
  },
  "bin": {
    "hysilens": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./runtime": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./demo": {
      "types": "./dist/demo.d.ts",
      "import": "./dist/demo.js"
    },
    "./samples": {
      "types": "./dist/samples.d.ts",
      "import": "./dist/samples.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack && vp run @hysilens/devtools#build"
  },
  "dependencies": {
    "fflate": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  }
}
